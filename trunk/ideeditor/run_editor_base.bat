@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo ============================================================
echo [ЛР №4] Компиляция и запуск текстового редактора (Стадия 1)
echo ============================================================

cargo build
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo [ОШИБКА] Сборка завершилась с ошибкой. Проверьте вывод компилятора выше.
    pause
    exit /b %ERRORLEVEL%
)

echo [OK] Сборка успешно завершена. Запуск приложения...
cargo run
