@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo ============================================================================
echo [ЛР №5] Компиляция и запуск редактора с подсветкой синтаксиса (Стадия 2)
echo ============================================================================

cargo build
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo [ОШИБКА] Сборка завершилась с ошибкой. Проверьте вывод компилятора выше.
    pause
    exit /b %ERRORLEVEL%
)

echo [OK] Сборка успешно завершена. Запуск приложения...
cargo run
